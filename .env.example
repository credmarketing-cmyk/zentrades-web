# Production domain used for canonical URLs, Open Graph tags, JSON-LD and the sitemap.
NEXT_PUBLIC_SITE_URL=https://zentrades.pro

# Optional: a WordPress install that still handles form submissions and AJAX
# (Forminator, Elementor forms, HubSpot). Requests to /wp-admin/admin-ajax.php
# and /wp-json/* are proxied here when set.
# WP_BACKEND_URL=https://cms.zentrades.pro

# Optional: where form submissions are sent (JSON POST), e.g. a Zapier/Make
# webhook or a CRM endpoint. Without it, checklists only offer Print / Save as
# PDF and the short forms show an email fallback.
# FORMS_WEBHOOK_URL=https://hooks.zapier.com/hooks/catch/...
