# Copy to .env.local for local overrides. On Vercel, set these in Project Settings → Environment Variables.
# None are required: the defaults below are what the site uses when unset.

# Canonical site URL used in canonical tags, Open Graph, sitemap.xml and robots.txt.
NEXT_PUBLIC_SITE_URL=https://zentrades.pro

# Pages are indexable only on Vercel production (VERCEL_ENV=production) or when this is "true".
# Leave unset for local/preview builds so search engines never index them.
# ALLOW_INDEXING=true
